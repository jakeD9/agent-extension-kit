HTTP_HOST=0.0.0.0
HTTP_PORT=3000
CONTENT_PATH=extension
CONTENT_REVISION=local-example
TEAM_AGENT_ALLOW_MUTABLE_CONTENT_REVISION=true
TEAM_AGENT_BOOTSTRAP_CONTENT_ON_STARTUP=true
DEV_AUTH_PRINCIPALS={"dev-token":{"id":"local-developer","groups":["engineering"],"projects":["event-ingestion"],"roles":[]}}
TEAM_AGENT_CONTEXT_URL=http://127.0.0.1:3000
TEAM_AGENT_TOKEN=dev-token

# Percent-encode credentials before placing them in a MongoDB URI outside local Compose.
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=local-root-password
TEAM_CONTEXT_MONGODB_USERNAME=team_context_service
TEAM_CONTEXT_MONGODB_PASSWORD=local-context-password
TEAM_CONTEXT_MONGODB_URI=mongodb://team_context_service:local-context-password@localhost:27017/team_context?authSource=team_context&replicaSet=team-agent-rs&directConnection=true
TEAM_CONTEXT_MONGODB_DATABASE=team_context
AGENT_RUNTIME_MONGODB_USERNAME=team_agent_service
AGENT_RUNTIME_MONGODB_PASSWORD=local-runtime-password
AGENT_RUNTIME_MONGODB_URI=mongodb://team_agent_service:local-runtime-password@localhost:27017/agent_runtime?authSource=agent_runtime&replicaSet=team-agent-rs&directConnection=true
AGENT_RUNTIME_MONGODB_DATABASE=agent_runtime
